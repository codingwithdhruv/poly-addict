#!/bin/bash

# Usage: ./trade [coin] [flags]
# Example: ./trade btc --shares=50

COIN=$1

case "$COIN" in
  -redeem|--redeem) npm run dev -- --redeem; exit $? ;;
  -info|--info) npm run dev -- --info; exit $? ;;
  -dashboard|--dashboard) npm run dev -- --dashboard; exit $? ;;
esac

if [ "$#" -gt 0 ]; then shift; fi
COIN=${COIN#--}
COIN=${COIN#-}

if [ -z "$COIN" ]; then
  echo "Usage: ./trade <coin> [options]"
  echo "Coins: btc, eth, sol, xrp"
  exit 1
fi



# Run the bot with the coin flag and any other passed arguments
npm run dev -- --$COIN "$@"
