# Polygon EOA signer. Required for trading and position maintenance.
PRIVATE_KEY=0x...

# Optional Polymarket account wallet (proxy/deposit wallet). When set, the bot
# trades from this wallet and maintenance scans both it and the EOA.
POLY_PROXY_ADDRESS=

# Polygon RPC endpoint. Add backups as RPC_URL_1 through RPC_URL_5.
RPC_URL=https://polygon-rpc.com
RPC_URL_1=

# Optional relayer API credentials for supported gasless account transactions.
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
